NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Run `npm run generate-wallets` to auto-generate both seller and buyer wallets
SELLER_ADDRESS=0xYourWalletAddress
SELLER_PRIVATE_KEY=0xYourSellerPrivateKey

# Signs dashboard sessions. `npm run generate-wallets` creates one for you;
# to make one yourself: openssl rand -hex 32   (16+ characters required)
SESSION_SECRET=your-long-random-secret

# Dashboard demo login (optional; defaults to admin@example.com / 123456)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

BUYER_PRIVATE_KEY=0xYourBuyerPrivateKey

# BASE_URL=http://localhost:3000
# DEPOSIT_AMOUNT=1
