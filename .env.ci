# Public CI env (safe to commit).
#
# ONLY public values belong here. NEVER add secrets (service-role key, private
# keys, OPENAI_API_KEY); those stay runtime-only and are injected at `docker run`
# / from GCP Secret Manager in the cluster.
#
# Two kinds of value live here, consumed by different CI steps:
#   NEXT_PUBLIC_*  — build-time. Compiled into the browser bundle, so they are
#                    fed to `docker build` as build-args.
#   HAIA_INGEST_*  — runtime. Passed to `helm upgrade` as config.* overrides, so
#                    both the seller and the buyer pods get them via the
#                    ConfigMap. Locally, copy them into .env.local.
#
# Replace the values below with your real Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://rqfqcvuefgylucvhthtn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_en2RJRE6gbA15jMBRUvCQA_4hwn4E3g

# Haia Control Plane — where Haia Trace mirrors its events (HAD-359).
# The token is a *publishable* ingest token (pit_*) for the x402 demo project:
# plaintext by design, carrying only `ingest:write`, so committing it is safe.
# Unset either variable and tracing falls back to the local .trace run file.
HAIA_INGEST_URL=https://haia-cp-ingest.gdev.haust.app
HAIA_INGEST_KEY=pit_TRACEx402demoAGENTorigin00000001
